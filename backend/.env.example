NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://photos:photos@postgres:5432/photos?schema=public
REDIS_URL=redis://redis:6379

# Optional: leave unset and the backend generates + persists a random
# secret in the app-data volume on first boot. Only set these explicitly if
# you need a stable secret across separately-provisioned deployments.
# JWT_SECRET=
JWT_EXPIRES_IN=15m
# JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

STORAGE_ROOT=/photos
THUMBNAIL_CACHE_ROOT=/photos-cache

ML_SERVICE_URL=http://ml-service:8000

GIT_REPO_PATH=/app
