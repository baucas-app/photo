NODE_ENV=development
PORT=3001

DATABASE_URL=postgresql://photos:photos@postgres:5432/photos?schema=public
REDIS_URL=redis://redis:6379

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-too-a-long-random-string
JWT_REFRESH_EXPIRES_IN=30d

STORAGE_ROOT=/photos
THUMBNAIL_CACHE_ROOT=/photos-cache

ML_SERVICE_URL=http://ml-service:8000

GIT_REPO_PATH=/app
